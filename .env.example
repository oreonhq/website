# DeepL API key (get one at https://www.deepl.com/pro-api)
# Copy this file to .env or .env.local and add your key, then run: npm run translate
# Pro keys use api.deepl.com, free tier uses api-free.deepl.com — the script switches on 403 if needed.
# Optional: DEEPL_PRO=1 forces the Pro API URL without probing.
DEEPL_AUTH_KEY=
